# Copy to .env for local development. DEVELOPMENT VALUES ONLY - never reuse in any shared environment.
DB_NAME=humanoid_ops
DB_HOST=localhost
DB_PORT=5440
DB_OWNER_USER=ops_owner
DB_OWNER_PASSWORD=ops_owner_dev
DB_APP_USER=ops_app
DB_APP_PASSWORD=ops_app_dev
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DJANGO_DEBUG=true
# Password for the synthetic dev users created by `make seed` (dev_admin, dev_ops_lead, ...)
DEV_SEED_PASSWORD=dev-only-password-123
